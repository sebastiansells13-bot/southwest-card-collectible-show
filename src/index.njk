---
layout: layouts/page.njk
title: Home
---
{% set next = collections.events | upcoming | first %}
<section class="hero">
  <div class="wrapper">
    <div class="arch arch--hero">
      <h1 class="sr-only">{{ business.name }}</h1>
      <p class="kicker">{{ home.kicker }}</p>
      {% include "components/neon-logo.njk" %}
      {% if next %}
      <div class="hero__when">
        <p class="hero__venue">{{ next.data.venue }}<br><span>{{ next.data.address }}</span></p>
        <p class="hero__date">{{ next.date | longDate }}</p>
        <p class="hero__time"><span>{{ next.data.time }}</span></p>
        <p class="script">Free Entry!</p>
      </div>
      <p class="actions">
        <a class="btn" href="{{ next.url | url }}">Show details</a>
        <a class="btn btn--ghost" href="{{ business.social.discord }}" rel="noopener">Join the Discord</a>
      </p>
      {% else %}
      <p class="hero__intro">Next show date coming soon — follow along on Instagram and Discord.</p>
      <p class="actions"><a class="btn" href="{{ business.social.instagram }}" rel="noopener">Follow on Instagram</a></p>
      {% endif %}
      <div class="ribbon ribbon--inset"><span>{{ business.name }}</span></div>
    </div>
  </div>
</section>

<section class="wrapper section">
  <p class="lede">{{ home.intro }}</p>
  <div class="perks">
    {% for perk in home.perks %}
    <div class="perk"><h3>{{ perk.title }}</h3><p>{{ perk.text }}</p></div>
    {% endfor %}
  </div>
</section>

<section class="section section--band">
  <div class="wrapper">
    <h2 class="section-title"><span>What's on the floor</span></h2>
    <ul class="tally">
      {% for c in home.categories %}
      <li><b>{{ c.count }}</b><span>{{ c.label }}</span></li>
      {% endfor %}
    </ul>
    <p class="center"><a class="btn btn--ghost" href="{{ '/vendors/' | url }}">See the vendor map</a></p>
  </div>
</section>

<section class="wrapper section">
  <h2 class="section-title"><span>Shows &amp; Trade Days</span></h2>
  <div class="event-grid">
    {% for event in collections.events | upcoming %}{% include "components/event-card.njk" %}{% endfor %}
    {% for event in collections.events | past | head(2) %}{% set past = true %}{% include "components/event-card.njk" %}{% endfor %}
  </div>
</section>

<section class="wrapper section cause">
  <div class="arch arch--flyer"><img src="{{ home.cause.image | url }}" alt="{{ home.cause.title }} flyer" loading="lazy"></div>
  <div>
    <p class="kicker">Giving back</p>
    <h2 class="glow">{{ home.cause.title }}</h2>
    <p>{{ home.cause.text }}</p>
  </div>
</section>

<section class="wrapper section">
  <h2 class="section-title"><span>Latest from the feed</span></h2>
  <div class="feed-grid">
    {% for post in collections.posts | reverse | head(6) %}
    <a class="feed-tile" href="{{ post.url | url }}">
      <img src="{{ post.data.image | url }}" alt="" loading="lazy">
      <span class="feed-tile__caption">{{ post.data.title }}</span>
    </a>
    {% endfor %}
  </div>
  <p class="center"><a class="btn" href="{{ business.social.instagram }}" rel="noopener">Follow {{ business.social.instagramHandle }}</a></p>
</section>

<section class="wrapper section">
  <div class="cta-panel">
    <h2>Never miss a drop</h2>
    <p>Show dates, table sales, giveaways and trade nights hit our Discord first.</p>
    <a class="btn" href="{{ business.social.discord }}" rel="noopener">Join the Discord</a>
  </div>
</section>
