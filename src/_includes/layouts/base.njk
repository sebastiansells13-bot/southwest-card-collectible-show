<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- The CSP ships in the HTML so it applies with or without the Cloudflare
      proxy. The form endpoints' origins (table requests, sponsor inquiries)
      are allowed only when set in the CMS; cloudflareinsights.com is
      Cloudflare Web Analytics (the beacon at the end of <body>). -#}
  {%- set formOrigin = booking.formEndpoint | safeUrl({ httpsOnly: true }) | urlOrigin -%}
  {%- set sponsorOrigin = sponsors.packages.formEndpoint | safeUrl({ httpsOnly: true }) | urlOrigin -%}
  {%- if sponsorOrigin and sponsorOrigin != formOrigin -%}{%- set formOrigin = (formOrigin + " " + sponsorOrigin) | trim -%}{%- endif %}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com{% if formOrigin %} {{ formOrigin }}{% endif %}; form-action 'self'{% if formOrigin %} {{ formOrigin }}{% endif %}; base-uri 'self'; object-src 'none'; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <script src="/js/lang-early.js"></script>
  {%- set siteName = business.name or metadata.title -%}
  {%- if page.url == "/" -%}
    {%- set pageTitle = metadata.homeTitle -%}{%- set pageTitleEs = metadata.homeTitleEs -%}
  {%- else -%}
    {#- Short brand suffix keeps inner-page titles near 60 characters. -#}
    {%- set pageTitle = (seoTitle or title) + " · " + (business.shortName or siteName) -%}{%- set pageTitleEs = seoTitleEs or titleEs -%}
  {%- endif -%}
  {%- set pageDescription = description or metadata.description -%}
  {%- set canonical = metadata.url + page.url -%}
  {%- set socialImage = metadata.url + (image or flyer or metadata.defaultImage) %}
  <title{% if pageTitleEs %} data-i18n-title-es="{{ pageTitleEs }}"{% endif %}>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if noindex %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <meta name="theme-color" content="#0a0a0c">
  <meta property="og:type" content="{{ 'article' if (tags and 'posts' in tags) else 'website' }}">
  <meta property="og:site_name" content="{{ siteName }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta property="og:image:alt" content="{{ (seoTitle or title) if page.url != '/' else siteName }} flyer">
  <meta property="og:locale" content="{{ metadata.locale }}">
  <meta property="og:locale:alternate" content="es_MX">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage }}">
  {% include "components/structured-data.njk" %}
  <link rel="icon" href="/img/brand/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png">
  <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">
</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip.toContent">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script type="application/json" id="i18n-data">{{ i18n | jsonld | safe }}</script>
  <script src="/js/i18n-runtime.js" defer></script>
  <script src="/js/i18n.js" defer></script>
  <script src="/js/nav.js" defer></script>
  {#- Cloudflare Web Analytics: cookie-free page view counts. The token is
      public by design. The site is set to manual setup in Cloudflare so the
      proxy doesn't inject a second beacon. -#}
  {% if metadata.analyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{{ { token: metadata.analyticsToken } | dump }}'></script>{% endif %}
</body>
</html>
