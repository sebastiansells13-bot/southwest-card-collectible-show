<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Hide the page until i18n.js has swapped in Spanish, so a returning
    // Spanish visitor never sees an English flash. i18n.js removes the
    // class; the timeout is a safety net if that script fails to load.
    try { if (localStorage.getItem("lang") === "es") { document.documentElement.classList.add("i18n-pending"); setTimeout(function () { document.documentElement.classList.remove("i18n-pending"); }, 1500); } } catch (e) {}
  </script>
  <title{% if titleEs %} data-i18n-title-es="{{ titleEs }}"{% endif %}>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ business.name or metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">
  <meta name="theme-color" content="#0a0a0c">
  <meta property="og:title" content="{{ title if title and title != 'Home' else business.name }}">
  <meta property="og:description" content="{{ description or metadata.description }}">
  <meta property="og:image" content="{{ metadata.url }}{{ (image or flyer or '/img/posts/october-show-flyer.jpg') }}">
  <meta property="og:type" content="website">
  <link rel="icon" href="/img/brand/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Bangers&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">
</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip.toContent">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script type="application/json" id="i18n-data">{{ i18n | dump | safe }}</script>
  <script src="/js/i18n-runtime.js" defer></script>
  <script src="/js/i18n.js" defer></script>
  <script>
    const t = document.querySelector(".nav-toggle");
    t && t.addEventListener("click", () => {
      const open = document.body.classList.toggle("nav-open");
      t.setAttribute("aria-expanded", open);
    });
  </script>
</body>
</html>
