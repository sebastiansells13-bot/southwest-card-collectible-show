{#- Only included when booking.open is on (see vendors.njk). -#}
{% from "macros/bilingual.njk" import bilingual %}
{% set reserved = booking.tables | byTableNumber %}
{% set W = floorLayout.width %}{% set H = floorLayout.height %}
<section class="wrapper section" id="pick-a-table">
  <h2 class="section-title"><span data-i18n="picker.title">Pick your table</span></h2>
  <p class="booking-show"><b>{{ bilingual(booking.showName, booking.showNameEs) }}</b><br>{{ bilingual(booking.showDate, booking.showDateEs) }} · {{ booking.venue }}</p>
  <p class="lede">{{ bilingual(booking.intro, booking.introEs) }}</p>

  {% if booking.pricing.length %}
  <ul class="pricing">
    {% for p in booking.pricing %}<li><span>{{ bilingual(p.label, p.labelEs) }}</span><b>{{ p.price }}</b></li>{% endfor %}
  </ul>
  {% endif %}

  <ul class="floor-legend" aria-label="Map key" data-i18n-attr="aria-label:picker.legendLabel">
    <li><i class="swatch swatch--open"></i><span data-i18n="picker.open">Open</span></li>
    <li><i class="swatch swatch--selected"></i><span data-i18n="picker.yourPick">Your pick</span></li>
    <li><i class="swatch swatch--pending"></i><span data-i18n="picker.requested">Requested</span></li>
    <li><i class="swatch swatch--taken"></i><span data-i18n="picker.taken">Taken</span></li>
  </ul>

  <div class="floor-scroll" tabindex="0" aria-label="Floor map, scrolls sideways" data-i18n-attr="aria-label:picker.mapLabel">
    <div class="floor" style="aspect-ratio: {{ W }} / {{ H }}">
      {% for l in floorLayout.landmarks %}
      <div class="floor__landmark{% if l.muted %} floor__landmark--muted{% endif %}{% if l.entrance %} floor__landmark--entrance{% endif %}" style="left:{{ floorLayout.pct(l.x, W) }};top:{{ floorLayout.pct(l.y, H) }};width:{{ floorLayout.pct(l.w, W) }};height:{{ floorLayout.pct(l.h, H) }}" aria-hidden="true"><span data-i18n="landmark.{{ l.label | slugify }}">{{ l.label }}</span></div>
      {% endfor %}
      {% for t in floorLayout.tables %}
      {% set r = reserved[t.n] %}
      {% set status = (r.status | slugify) if r else "open" %}
      {% set statusKey = "picker.status." + status %}
      <button type="button" class="floor__table is-{{ status }}" data-table="{{ t.n }}" style="left:{{ floorLayout.pct(t.x, W) }};top:{{ floorLayout.pct(t.y, H) }};width:{{ floorLayout.pct(t.w, W) }};height:{{ floorLayout.pct(t.h, H) }}"
        {% if r %}disabled{% else %}aria-pressed="false"{% endif %}
        aria-label="Table {{ t.n }}, {{ r.status if r else 'open' }}{% if r.vendor %}, {{ r.vendor }}{% endif %}"
        data-i18n-attr="aria-label:picker.tableLabel" data-i18n-vars="{{ { n: t.n, status: i18n[statusKey].es, vendor: (', ' + r.vendor) if r.vendor else '' } | dump }}">{{ t.n }}</button>
      {% endfor %}
    </div>
  </div>
  <p class="floor-hint" data-i18n="picker.hint">On a phone? Scroll the map sideways, or just type table numbers in the form.</p>

  <form class="booking-form" id="booking-form" method="POST"{% set endpoint = booking.formEndpoint | safeUrl({ httpsOnly: true }) %}{% if endpoint %} action="{{ endpoint }}"{% endif %} data-endpoint="{{ endpoint }}" data-max="{{ booking.maxTables }}" novalidate>
    <input type="hidden" name="_subject" value="Table request: {{ booking.showName }}">
    <input type="hidden" name="show" value="{{ booking.showName }} ({{ booking.showDate }})">
    <input type="hidden" name="language" value="en">
    <div class="booking-form__tables">
      <label for="tables-input"><span data-i18n="picker.tablesLabel">Tables you want</span> <small data-i18n="picker.upTo" data-i18n-vars="{{ { max: booking.maxTables } | dump }}">(up to {{ booking.maxTables }})</small></label>
      <input id="tables-input" name="tables" type="text" inputmode="numeric" maxlength="40" placeholder="Tap tables on the map, or type e.g. 42, 43" data-i18n-placeholder="picker.tablesPlaceholder" autocomplete="off" required>
      <p class="booking-form__msg" id="tables-msg" aria-live="polite"></p>
    </div>
    <div class="booking-form__grid">
      <label><span data-i18n="form.name">Your name</span><input name="name" type="text" autocomplete="name" maxlength="100" required></label>
      <label><span data-i18n="form.business">Business / shop name</span><input name="business" type="text" autocomplete="organization" maxlength="120"></label>
      <label><span data-i18n="form.email">Email</span><input name="email" type="email" autocomplete="email" maxlength="254" required></label>
      <label><span data-i18n="form.phone">Phone</span><input name="phone" type="tel" autocomplete="tel" maxlength="30"></label>
      <label><span data-i18n="form.instagram">Instagram handle</span><input name="instagram" type="text" maxlength="60" placeholder="@yourshop" data-i18n-placeholder="form.instagramPlaceholder"></label>
    </div>
    <fieldset class="booking-form__cats">
      <legend data-i18n="form.selling">What you'll be selling</legend>
      {% for c in booking.categories %}
      <label><input type="checkbox" name="selling" value="{{ c.label }}"> {{ bilingual(c.label, c.labelEs) }}</label>
      {% endfor %}
    </fieldset>
    <label class="booking-form__notes"><span><span data-i18n="form.notes">Anything else?</span> <small data-i18n="form.notesHint">(power, neighbors you'd like, a backup table choice)</small></span><textarea name="notes" rows="3" maxlength="1000"></textarea></label>
    <input type="text" name="_gotcha" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
    <p class="booking-form__fine">{{ bilingual(booking.confirmNote, booking.confirmNoteEs) }}</p>
    <p class="booking-form__fine" data-i18n="form.privacy{{ 'Sent' if endpoint else 'Local' }}">{% if endpoint %}We only use these details to arrange your table. They're emailed to the show organizers through our form service and never sold or shared.{% else %}Nothing is sent from this page: you'll copy your request and send it to us yourself. We only use your details to arrange your table.{% endif %}</p>
    <p class="booking-form__error" id="form-error" role="alert" hidden></p>
    <button class="btn" type="submit" data-i18n="form.submit">Request my tables</button>
  </form>

  <div class="booking-done" id="booking-done" hidden tabindex="-1">
    <h3 class="glow" data-i18n="done.title">Request ready!</h3>
    <div id="done-sent" hidden>
      <p><span data-i18n="done.thanks">Thanks — we got your request for</span> <b data-done-tables></b>. {{ bilingual(booking.confirmNote, booking.confirmNoteEs) }}</p>
      {% if booking.paymentLink %}
      <p>{% if booking.paymentNote %}{{ bilingual(booking.paymentNote, booking.paymentNoteEs) }}{% else %}<span data-i18n="done.payNote">Lock it in faster by paying your table fee now:</span>{% endif %}</p>
      <p class="actions"><a class="btn" href="{{ booking.paymentLink | safeUrl }}" rel="noopener" data-i18n="done.pay">Pay table fee</a></p>
      {% endif %}
    </div>
    <div id="done-manual" hidden>
      <p><span data-i18n="done.copyIntro">Copy your request below and send it to us on Instagram or Discord. We'll confirm it for you:</span> <b data-done-tables></b></p>
      <textarea id="done-summary" rows="8" readonly aria-label="Your request" data-i18n-attr="aria-label:done.summaryLabel"></textarea>
      <p class="actions">
        <button class="btn" type="button" id="copy-summary" data-i18n="done.copy">Copy request</button>
        <a class="btn btn--ghost" href="{{ business.social.instagram | safeUrl }}" rel="noopener" data-i18n="done.openInstagram">Open Instagram</a>
        <a class="btn btn--ghost" href="{{ business.social.discord | safeUrl }}" rel="noopener" data-i18n="done.openDiscord">Open Discord</a>
      </p>
    </div>
  </div>
</section>
<script src="/js/table-picker.js" defer></script>
