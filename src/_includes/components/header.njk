<header class="site-header">
  <div class="wrapper">
    <a class="brand" href="{{ '/' }}">
      <img src="{{ '/img/brand/logo.jpg' }}" alt="" width="44" height="44">
      <span class="brand__text">Southwest <b>Card &amp; Collectible</b> Show</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav"><span class="sr-only">Menu</span><span class="nav-toggle__bars" aria-hidden="true"></span></button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {% for item in navigation %}
        {% set active = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if active %} class="is-active" aria-current="page"{% endif %}>{{ item.text }}</a></li>
        {% endfor %}
        <li><a class="btn btn--small" href="{{ business.social.discord }}" rel="noopener">Join Discord</a></li>
      </ul>
    </nav>
  </div>
</header>
