---
layout: layouts/page.njk
title: News
titleEs: Noticias
permalink: /news/
seoTitle: News & Show Updates
seoTitleEs: Noticias y novedades
description: Announcements, vendor maps, giveaways and recaps from the Southwest Card & Collectible Show in Las Cruces, NM.
---
{% from "macros/bilingual.njk" import bilingual %}
<section class="page-hero wrapper">
  <p class="kicker" data-i18n="news.kicker">From the feed</p>
  <h1 class="glow" data-i18n="nav.news">News</h1>
</section>
<section class="wrapper section">
  <div class="feed-grid">
    {% for post in collections.posts | reverse %}
    <a class="feed-tile" href="{{ post.url }}">
      {% if post.data.image %}<img src="{{ post.data.image }}" alt="" loading="lazy">{% endif %}
      <span class="feed-tile__caption"><time datetime="{{ post.date | htmlDateString }}" data-i18n-date="readable">{{ post.date | readableDate }}</time>{{ bilingual(post.data.title, post.data.titleEs) }}</span>
    </a>
    {% endfor %}
  </div>
</section>
